# ─────────────────────────────────────────────────────────────────────────────
#  JustPrompt — API keys.  Copy this file to ".env" and paste your keys.
#  You do NOT need all of them. The app works with whatever you provide and
#  clearly shows which engines are live vs. "add a key to enable".
#  Every key below has a FREE tier (no credit card for Groq / Gemini / OpenRouter).
# ─────────────────────────────────────────────────────────────────────────────

# OpenRouter — one key, many models (GPT, Claude, Gemini, Llama, DeepSeek, Perplexity).
# Has genuinely FREE models and cheap paid ones. This is the "all engines" gateway.
# Get it free at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Google Gemini — the only FREE source of LIVE web-grounded answers + real citations.
# Strongly recommended: this is what makes GEO tracking reflect the real-time web.
# Get it free at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq — fastest free inference. Used for the analysis work (keyword mining,
# mention + sentiment judging) and as a free answer engine (model knowledge).
# Get it free at: https://console.groq.com/keys
GROQ_API_KEY=

# ── Optional: direct keys for the real paid engines (light up extra slots) ──
# OpenAI (real ChatGPT):      https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Anthropic (real Claude):    https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Perplexity (live web):      https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=

# ── Server ──
PORT=4505

# How many prompts to track in parallel during "Check ranking". Higher = faster,
# but more likely to hit free-tier rate limits (requests auto-retry on 429).
# 4 is a good default; try 6-8 on OpenRouter/paid, 2-3 if you see many 429s.
TRACK_CONCURRENCY=4
