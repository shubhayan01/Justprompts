# ─────────────────────────────────────────────────────────────────────────────
#  JustPrompt — API keys.  Copy this file to ".env" and paste your keys.
#  You do NOT need all of them. The app works with whatever you provide and
#  clearly shows which engines are live vs. "add a key to enable".
#  Every key below has a FREE tier (no credit card for Groq / Gemini / OpenRouter).
# ─────────────────────────────────────────────────────────────────────────────

# OpenRouter — one key, many models (GPT, Claude, Gemini, Llama, DeepSeek, Perplexity).
# Has genuinely FREE models and cheap paid ones. This is the "all engines" gateway.
# Get it free at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Google Gemini — the only FREE source of LIVE web-grounded answers + real citations.
# Strongly recommended: this is what makes GEO tracking reflect the real-time web.
# Get it free at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq — fastest free inference. Used for the analysis work (keyword mining,
# mention + sentiment judging) and as a free answer engine (model knowledge).
# Get it free at: https://console.groq.com/keys
GROQ_API_KEY=

# ── Optional: direct keys for the real paid engines (light up extra slots) ──
# OpenAI (real ChatGPT):      https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Anthropic (real Claude):    https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Perplexity (live web):      https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=

# ── Google keyword rank tracking (DataForSEO) ──
# Powers the "Google Rank" tab: where your site ranks on Google for each keyword.
# Basic-auth LOGIN + PASSWORD (not a single token). Also settable from the UI.
# Get credentials at: https://app.dataforseo.com/api-access
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# How many keywords to check in parallel (each is one DataForSEO SERP request):
DATAFORSEO_CONCURRENCY=5

# ── Semrush v4 API (keyword data, Google rankings, domain comparison) ──
# Powers the "Semrush" panel on the Google Rank tab: real search volume, keyword
# difficulty, CPC & intent, your organic rankings, and a brand-vs-competitor table.
# A single v4 "Apikey" TOKEN (starts "semrtkn-pat-…"), NOT the classic hex ?key=.
# Needs a plan with API access + API units; otherwise calls return 403 Forbidden.
# Create/permission the key at: https://www.semrush.com/accounts/api-keys/active
SEMRUSH_API_KEY=
# How many keyword-metric lookups to run in parallel (each is one 20-unit request):
SEMRUSH_CONCURRENCY=4
# How long to cache results before re-spending units (default 7 days, in ms):
# SEMRUSH_CACHE_TTL_MS=604800000

# ── Optional: headless "ghost" browser engines (real ChatGPT + Google AI) ──
# No API cost — drives the real consumer pages with a local Chromium. Best-effort:
# may need a one-time login / CAPTCHA solve and can break when those sites change.
# Turn on from the UI, or set ENABLE_GHOST=1 here. Requires:
#   npm i playwright && npx playwright install chromium
ENABLE_GHOST=0
# Show the browser window (needed for the first ChatGPT login / any CAPTCHA):
GHOST_HEADLESS=0
# GHOST_PROFILE_DIR=./data/ghost-profile   # where the logged-in session is kept
# GHOST_TIMEOUT_MS=60000

# ── Server ──
PORT=4505

# How many prompts to track in parallel during "Check ranking". Higher = faster,
# but more likely to hit free-tier rate limits (requests auto-retry on 429).
# 4 is a good default; try 6-8 on OpenRouter/paid, 2-3 if you see many 429s.
TRACK_CONCURRENCY=4

# Speed: each answer also makes one small "judge" call (rank + sentiment).
# Set to 1 to SKIP it — runs are roughly 2x faster and still measure brand
# mentions, citations and share of voice (just no LLM-scored rank/sentiment).
DISABLE_JUDGE=0
